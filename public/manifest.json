{
  "manifest_version": 3,
  "name": "HoverSub — перевод по наведению",
  "version": "0.4.0",
  "description": "Перевод слов в субтитрах через Google Cloud или MyMemory. Выбор сервиса и опциональная автопауза.",
  "permissions": ["storage", "scripting", "activeTab", "webNavigation"],
  "host_permissions": ["https://translation.googleapis.com/*", "https://api.mymemory.translated.net/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {"scripts": ["background.js"]},
  "action": {"default_popup": "popup.html", "default_icon": "icon.svg"},
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "browser_specific_settings": {
    "gecko": {
      "id": "hoversub@local.extension",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}
    }
  }
}
